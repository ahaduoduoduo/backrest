FROM alpine:latest
LABEL org.opencontainers.image.source="https://github.com/ahaduoduoduo/backrest"
RUN apk --no-cache add tini ca-certificates curl bash openssh sqlite tzdata docker-cli
RUN mkdir -p /tmp

ARG TARGETPLATFORM
# Binaries are staged per-platform by goreleaser dockers_v2
COPY $TARGETPLATFORM/backrest /backrest
COPY $TARGETPLATFORM/docker-entrypoint /docker-entrypoint

# Run the binary to install dependencies (may run via QEMU but necessary).
# GitHub Releases can return transient 5xx responses, so keep the image build
# deterministic while allowing a small number of bounded retries.
RUN set -eu; \
    attempt=1; \
    until /backrest --install-deps-only; do \
        if [ "$attempt" -ge 5 ]; then \
            exit 1; \
        fi; \
        sleep_seconds=$((attempt * 5)); \
        echo "restic dependency download failed; retrying in ${sleep_seconds}s (${attempt}/5)"; \
        sleep "$sleep_seconds"; \
        attempt=$((attempt + 1)); \
    done

# Setup path for restic
RUN mkdir -p /bin && mv /root/.local/share/backrest/restic /bin/restic

ENTRYPOINT ["/sbin/tini", "--", "/docker-entrypoint"]
CMD ["/backrest"]
